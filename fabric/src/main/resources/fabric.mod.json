{
  "schemaVersion": 1,
  "id": "stream-tweaks",
  "version": "${version}",
  "name": "Stream Tweaks",
  "description": "A client-side mod that displays Twitch chat directly in Minecraft, designed to enhance interaction during streams. Future updates will add moderation features such as message deletion and user bans.",
  "authors": [
    "etwas"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/stream-tweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.etwas.streamtweaks.mod.StreamTweaksClient"
    ],
    "main": [
      "org.etwas.streamtweaks.mod.StreamTweaks"
    ],
    "modmenu": [
      "org.etwas.streamtweaks.mod.ModMenuIntegration"
    ]
  },
  "mixins": [
    "stream-tweaks.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "26.2"
  }
}
